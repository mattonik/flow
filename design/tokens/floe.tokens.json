  "conventions": {
    "use": "Semantic role tokens for product UI; primitives only for graphics and exploratory composition.",
    "type": "A DTCG-inspired JSON data source; validate consumers before claiming complete format compatibility.",
    "motion": "Platform gestures and compositor transitions are not implemented by these values.",
    "name": "Floe is product; Flow is spatial navigation; IceBear is creator; Nival is reserved for possible future ecosystem."
  },
  "theme-policy": {
    "default": "dark",
    "modes": [
      "dark",
      "light"
    ],
    "light-mode": "Soft Arctic daylight, no pure #fff surfaces; dark ink and mineral fog replaces stark white.",
    "preference": "Per-user explicit setting; optionally follow operating system when reliable, but never change without user control.",
    "scope": "Floe shell UI and supported themeable tools only; existing applications retain their own preferences.",
    "accessibility": "Body/small text AA 4.5:1 or greater on its rendered surface; focus indicator perceivable, touch targets 44dp minimum; reduced motion supported."
  }
