      }
    },
    "fallbackPolicy": {
      "ui": "Noto Sans is the preferred UI family. Fontconfig and Qt choose script-specific Noto fallback; no single font file has worldwide Unicode coverage.",
      "cjk": "Install Noto Sans CJK, respecting language metadata for Simplified Chinese, Traditional Chinese, Japanese and Korean glyph variants.",
      "complexScripts": "Test appropriate script-specific Noto fonts and shaping for Arabic, Hebrew, Indic scripts and Southeast Asian writing systems.",
      "emoji": "Noto Color Emoji is available as system fallback; avoid using emoji alone for unlabeled controls.",
      "bidirectional": "Test RTL UI mirroring and mixed-direction Arabic/Hebrew text; glyph coverage alone does not solve bidi layout.",
      "licensing": "Review SIL OFL notices and font package contents before redistributing custom system images."
    }
  },
