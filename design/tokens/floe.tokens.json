  "conventions": {
    "use": "Semantic role tokens for product UI; primitives only for graphics and exploratory composition.",
    "type": "A DTCG-inspired JSON data source; validate consumers before claiming complete format compatibility.",
    "motion": "Platform gestures and compositor transitions are not implemented by these values.",
    "name": "Floe is product; Flow is spatial navigation; IceBear is creator; Nival is reserved for possible future ecosystem."
  }
