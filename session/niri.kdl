input {
    keyboard { xkb {}; }
    touchpad { tap; natural-scroll; }
}
layout {
    gaps 0
    default-column-width { proportion 1.0; }
    focus-ring { width 2; }
}
// Colours come from the design tokens. The first include is Polar Night; the second is the Desk's
// current appearance, which the installed shell writes and Niri reloads when it changes.
include "@niriAppearance@"
// Throwaway CI proof, reverted in the next commit: @ciProofPlaceholder@
include optional=true "~/.config/flow/niri-appearance.kdl"
hotkey-overlay { skip-at-startup; }
// The shell is the flow-shell user unit, started with niri.service (modules/flow.nix).
spawn-at-startup "@idle@" "-C" "/dev/null" "-w" "lock" "@lock@ -f" "before-sleep" "@lock@ -f"

binds {
    Super+I { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "quick"; }
    Super+M { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "menu"; }
    Super+K { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "search"; }
    Super+Shift+K { spawn "@keyboard@"; }
    Super+P { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "pin"; }
    Super+1 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "1"; }
    Super+2 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "2"; }
    Super+3 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "3"; }
    Super+4 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "4"; }
    Super+5 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "5"; }
    Super+6 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "6"; }
    Super+7 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "7"; }
    Super+8 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "8"; }
    Super+9 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "9"; }
    Super+Alt+1 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "1"; }
    Super+Alt+2 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "2"; }
    Super+Alt+3 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "3"; }
    Super+Alt+4 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "4"; }
    Super+Alt+5 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "5"; }
    Super+Alt+6 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "6"; }
    Super+Alt+7 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "7"; }
    Super+Alt+8 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "8"; }
    Super+Alt+9 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "display_digit" "9"; }
    Super+Return { spawn "@terminal@"; }
    Super+L allow-when-locked=true { spawn "@lock@"; }
    Super+Left { spawn "@spaces@" "navigate" "left"; }
    Super+Right { spawn "@spaces@" "navigate" "right"; }
    // A display's spaces are one row (one workspace per display), so every wheel direction moves along
    // it. The wheel goes through the running shell, which drops a notch while a step is in progress.
    // Niri's documentation says Overview takes Mod+wheel binds without the modifier held; Flow's Mod
    // is Super, as on a TTY. A touchpad scrolls Overview with Niri's own gestures.
    Super+WheelScrollDown cooldown-ms=150 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "navigate" "right"; }
    Super+WheelScrollUp cooldown-ms=150 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "navigate" "left"; }
    Super+WheelScrollRight cooldown-ms=150 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "navigate" "right"; }
    Super+WheelScrollLeft cooldown-ms=150 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "navigate" "left"; }
    Super+Up { spawn "@spaces@" "focus-member" "up"; }
    Super+Down { spawn "@spaces@" "focus-member" "down"; }
    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Q { close-window; }
    Super+O { toggle-overview; }
    Super+Tab { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "switcher"; }
    Super+H { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "toggle"; }
    Super+Shift+Slash { show-hotkey-overlay; }
    Super+Shift+E { quit; }
}
