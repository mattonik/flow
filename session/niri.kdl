input {
    keyboard { xkb {}; }
    touchpad { tap; natural-scroll; }
}
layout {
    gaps 0
    default-column-width { proportion 1.0; }
    focus-ring { width 2; active-color "#b8ddcb"; inactive-color "#172128"; }
    background-color "#0b1015"
}
hotkey-overlay { skip-at-startup; }
spawn-at-startup "@shell@" "-p" "@shellConfig@"
spawn-at-startup "@idle@" "-C" "/dev/null" "-w" "lock" "@lock@ -f -c 0b1015" "before-sleep" "@lock@ -f -c 0b1015"

binds {
    Super+I { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "quick"; }
    Super+M { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "menu"; }
    Super+K { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "search"; }
    Super+P { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "pin"; }
    Super+1 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "1"; }
    Super+2 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "2"; }
    Super+3 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "3"; }
    Super+4 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "4"; }
    Super+5 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "5"; }
    Super+6 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "6"; }
    Super+7 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "7"; }
    Super+8 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "8"; }
    Super+9 { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "focus" "9"; }
    Super+Return { spawn "@terminal@"; }
    Super+L allow-when-locked=true { spawn "@lock@" "-c" "0b1015"; }
    Super+Left { focus-column-left; }
    Super+Right { focus-column-right; }
    Super+Up { focus-window-up; }
    Super+Down { focus-window-down; }
    Super+Shift+Left { move-column-left; }
    Super+Shift+Right { move-column-right; }
    Super+Q { close-window; }
    Super+O { toggle-overview; }
    Super+Tab { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "switcher"; }
    Super+H { spawn "@shell@" "ipc" "-p" "@shellConfig@" "call" "desk" "toggle"; }
    Super+Shift+Slash { show-hotkey-overlay; }
    Super+Shift+E { quit; }
}
